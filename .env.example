# Required — get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional — raises GitHub API rate limit from 60/hr to 5,000/hr
# Create a token at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Optional
PORT=3000
GROQ_MODEL=openai/gpt-oss-120b

# Optional limits (defaults shown)
# Most characters of repo code sent to the model in one review
MAX_TOTAL_CHARS=12000
# Reviews allowed per visitor every 10 minutes
RATE_LIMIT_PER_10_MIN=10
# Reviews allowed across all visitors every 10 minutes
GLOBAL_LIMIT_PER_10_MIN=600
